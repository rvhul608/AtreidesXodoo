# Web Configuration
WEB_PORT=5173
WEB_HOST=localhost

# Session/Security
SESSION_SECRET=your-secret-key-change-in-production
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Mail/Outbox (database-backed only)
