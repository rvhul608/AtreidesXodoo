# Database Configuration
DATABASE_URL=postgresql://brightloop:password@localhost:5432/brightloop_dev
DB_HOST=localhost
DB_PORT=5432
DB_NAME=brightloop_dev
DB_USER=brightloop
DB_PASSWORD=password

# API Configuration
API_PORT=3000
API_HOST=localhost
NODE_ENV=development

# Web Configuration
WEB_PORT=5173
WEB_HOST=localhost

# Session/Security
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local development admin created by npm run seed
SEED_ADMIN_EMAIL=admin@brightloop.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# Mail: pending outbox messages are delivered automatically when both values are set.
RESEND_API_KEY=
MAIL_FROM=
WEB_ORIGIN=http://localhost:5173

# Billing workers claim disjoint batches. Leave pool capacity for interactive requests.
BILLING_CONCURRENCY=4
BILLING_BATCH_SIZE=100
